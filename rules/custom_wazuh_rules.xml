<!-- ================================================================= -->
<!-- Custom Wazuh Detection Rules for Mini-SOC Lab                     -->
<!-- Location: /var/ossec/etc/rules/local_rules.xml                    -->
<!-- ================================================================= -->

<group name="windows,security_lab,">

  <!-- Rule 1: Detect failed login attempts -->
  <rule id="100001" level="10" frequency="3" timeframe="60" >
    <if_group>authentication_failed</if_group>
    <field name="win.eventdata.targetUserName">^fake_admin_account$</field>
    <description>SOC Lab Alert: Failed login attempt against fake_admin_account.</description>
    <mitre><id>T1110</id></mitre>
</rule>

  <!-- Rule 2: Detect suspicious Office-to-interpreter process creation -->
  <rule id="100002" level="10">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)\\(WINWORD|EXCEL|POWERPNT|OUTLOOK)\.EXE$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(powershell|pwsh|cmd|wscript|cscript|mshta)\.exe$</field>
    <description>SOC Alert: Office application spawned a command interpreter or script host.</description>
    <mitre><id>T1059</id></mitre>
</rule>

</group>

